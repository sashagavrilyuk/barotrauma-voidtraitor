diff --git a/Barotrauma/BarotraumaP2PHost/Program.cs b/Barotrauma/BarotraumaP2PHost/Program.cs
new file mode 100644
index 0000000..f1f8fdf
--- /dev/null
+++ b/Barotrauma/BarotraumaP2PHost/Program.cs
@@ -0,0 +1,218 @@
+﻿#nullable enable
+using Barotrauma.Extensions;
+using Barotrauma.Networking;
+using System;
+using System.Collections.Immutable;
+using System.Diagnostics;
+using System.IO;
+using System.Security.Cryptography;
+using System.Threading;
+using System.Threading.Tasks;
+using System.Xml.Linq;
+
+namespace Barotrauma;
+
+internal static class P2PHostProgram
+{
+    private static volatile bool stopRequested;
+
+    private sealed record HostSettings(string ServerName, int MaxPlayers, bool IsPublic, bool HasPassword);
+
+    public static int Main()
+    {
+        Directory.SetCurrentDirectory(AppContext.BaseDirectory);
+        DebugConsole.MessageHandler.Register("headlessp2phost".ToIdentifier(), msg => Console.WriteLine(msg.Text));
+        Console.CancelKeyPress += (_, e) =>
+        {
+            e.Cancel = true;
+            stopRequested = true;
+        };
+
+        P2POwnerPeer? ownerPeer = null;
+        Steamworks.Data.Lobby? lobby = null;
+
+        try
+        {
+            HostSettings settings = ReadHostSettings();
+
+            Steamworks.SteamClient.Init(Steam.SteamManager.AppID, false);
+            if (!Steamworks.SteamClient.IsValid || !Steamworks.SteamClient.IsLoggedOn)
+            {
+                throw new InvalidOperationException("Steam client is not initialized or not logged on.");
+            }
+
+            var steamId = new SteamId(Steamworks.SteamClient.SteamId);
+            var endpoint = new SteamP2PEndpoint(steamId);
+            Console.WriteLine($"Steam initialized: {Steamworks.SteamClient.Name} ({steamId.StringRepresentation})");
+
+            InitializeRelayNetwork();
+
+            int ownerKey = RandomNumberGenerator.GetInt32(1, int.MaxValue);
+            var callbacks = new ClientPeer.Callbacks(
+                OnMessageReceived: _ => { },
+                OnDisconnect: packet =>
+                {
+                    Console.WriteLine($"P2P owner disconnected: {packet.DisconnectReason}");
+                    stopRequested = true;
+                },
+                OnInitializationComplete: () => { });
+
+            ownerPeer = new P2POwnerPeer(
+                callbacks,
+                ownerKey,
+                ImmutableArray.Create<P2PEndpoint>(endpoint),
+                headlessOwnerName: "P2P Host");
+            ownerPeer.Start();
+            TaskPool.Update();
+
+            if (!ownerPeer.IsActive)
+            {
+                throw new InvalidOperationException("Failed to start P2P owner peer.");
+            }
+
+            string serverExe = Path.Combine(AppContext.BaseDirectory, "DedicatedServer.exe");
+            if (!File.Exists(serverExe))
+            {
+                throw new FileNotFoundException("DedicatedServer.exe was not found next to the P2P host.", serverExe);
+            }
+
+            var processInfo = new ProcessStartInfo
+            {
+                FileName = serverExe,
+                WorkingDirectory = AppContext.BaseDirectory,
+                UseShellExecute = false
+            };
+            processInfo.ArgumentList.Add("-endpoint");
+            processInfo.ArgumentList.Add(endpoint.StringRepresentation);
+            processInfo.ArgumentList.Add("-ownerkey");
+            processInfo.ArgumentList.Add(ownerKey.ToString());
+            processInfo.ArgumentList.Add("-headlessp2powner");
+
+            ChildServerRelay.Start(processInfo);
+            Console.WriteLine("DedicatedServer started through the P2P relay.");
+
+            lobby = CreateLobby(settings, steamId, ownerPeer);
+            Console.WriteLine($"Steam lobby created: {lobby.Value.Id}");
+            Console.WriteLine("Headless P2P host is running. Press Ctrl+C to stop.");
+
+            var stopwatch = Stopwatch.StartNew();
+            double previousTime = stopwatch.Elapsed.TotalSeconds;
+            while (!stopRequested && ownerPeer.IsActive && ChildServerRelay.IsProcessAlive)
+            {
+                double now = stopwatch.Elapsed.TotalSeconds;
+                float deltaTime = (float)Math.Max(now - previousTime, 0.0);
+                previousTime = now;
+
+                Timing.TotalTime += deltaTime;
+                Timing.TotalTimeUnpaused += deltaTime;
+                Steamworks.SteamClient.RunCallbacks();
+                TaskPool.Update();
+                ownerPeer.Update(deltaTime);
+                Thread.Sleep(8);
+            }
+
+            return ChildServerRelay.Process is { HasExited: true } process ? process.ExitCode : 0;
+        }
+        catch (Exception e)
+        {
+            Console.Error.WriteLine(e);
+            return 1;
+        }
+        finally
+        {
+            lobby?.Leave();
+            ownerPeer?.Close(PeerDisconnectPacket.WithReason(DisconnectReason.ServerShutdown));
+            if (ChildServerRelay.IsProcessAlive)
+            {
+                ChildServerRelay.AttemptGracefulShutDown();
+            }
+            Steam.SteamManager.ShutDown();
+        }
+    }
+
+    private static void InitializeRelayNetwork()
+    {
+        Steamworks.SteamNetworkingUtils.InitRelayNetworkAccess();
+        var stopwatch = Stopwatch.StartNew();
+        while (Steamworks.SteamNetworkingUtils.Status.Avail != Steamworks.SteamNetworkingAvailability.Current)
+        {
+            Steamworks.SteamClient.RunCallbacks();
+            var status = Steamworks.SteamNetworkingUtils.Status;
+            if (status.Avail is Steamworks.SteamNetworkingAvailability.CannotTry
+                or Steamworks.SteamNetworkingAvailability.Previously
+                or Steamworks.SteamNetworkingAvailability.Failed)
+            {
+                throw new InvalidOperationException($"Steam relay initialization failed: {status.Avail}: {status.Msg}");
+            }
+            if (stopwatch.Elapsed > TimeSpan.FromSeconds(30))
+            {
+                throw new TimeoutException($"Steam relay initialization timed out: {status.Avail}: {status.Msg}");
+            }
+            Thread.Sleep(25);
+        }
+        Console.WriteLine("Steam Datagram Relay network is ready.");
+    }
+
+    private static Steamworks.Data.Lobby? CreateLobby(HostSettings settings, SteamId steamId, P2POwnerPeer ownerPeer)
+    {
+        Task<Steamworks.Data.Lobby?> task = Steamworks.SteamMatchmaking.CreateLobbyAsync(settings.MaxPlayers + 10);
+        var stopwatch = Stopwatch.StartNew();
+        double previousTime = stopwatch.Elapsed.TotalSeconds;
+        while (!task.IsCompleted)
+        {
+            double now = stopwatch.Elapsed.TotalSeconds;
+            float deltaTime = (float)Math.Max(now - previousTime, 0.0);
+            previousTime = now;
+
+            Timing.TotalTime += deltaTime;
+            Timing.TotalTimeUnpaused += deltaTime;
+            Steamworks.SteamClient.RunCallbacks();
+            TaskPool.Update();
+            ownerPeer.Update(deltaTime);
+            if (stopwatch.Elapsed > TimeSpan.FromSeconds(30))
+            {
+                throw new TimeoutException("Steam lobby creation timed out.");
+            }
+            Thread.Sleep(16);
+        }
+
+        Steamworks.Data.Lobby? lobby = task.GetAwaiter().GetResult();
+        if (lobby is null) { throw new InvalidOperationException("Failed to create Steam lobby."); }
+
+        if (settings.IsPublic) { lobby.Value.SetPublic(); }
+        else { lobby.Value.SetFriendsOnly(); }
+        lobby.Value.SetJoinable(true);
+        lobby.Value.SetData("lobbyowner", steamId.StringRepresentation);
+        lobby.Value.SetData("servername", settings.ServerName);
+        lobby.Value.SetData("version", GameMain.Version.ToString());
+        lobby.Value.SetData("maxplayers", settings.MaxPlayers.ToString());
+        lobby.Value.SetData("haspassword", settings.HasPassword.ToString());
+        lobby.Value.SetData("playercount", "0");
+
+        return lobby;
+    }
+
+    private static HostSettings ReadHostSettings()
+    {
+        const string settingsPath = "serversettings.xml";
+        if (!File.Exists(settingsPath))
+        {
+            return new HostSettings("Server", 10, false, false);
+        }
+
+        XElement? root = XDocument.Load(settingsPath).Root;
+        if (root is null) { return new HostSettings("Server", 10, false, false); }
+
+        string serverName = root.Attribute(nameof(ServerSettings.ServerName))?.Value
+                            ?? root.Attribute("name")?.Value
+                            ?? "Server";
+        int maxPlayers = int.TryParse(root.Attribute(nameof(ServerSettings.MaxPlayers))?.Value, out int parsedMaxPlayers)
+            ? parsedMaxPlayers
+            : 10;
+        bool isPublic = bool.TryParse(root.Attribute(nameof(ServerSettings.IsPublic))?.Value, out bool parsedPublic)
+            && parsedPublic;
+        bool hasPassword = !string.IsNullOrEmpty(root.Attribute("password")?.Value);
+
+        return new HostSettings(serverName, Math.Max(maxPlayers, 1), isPublic, hasPassword);
+    }
+}
