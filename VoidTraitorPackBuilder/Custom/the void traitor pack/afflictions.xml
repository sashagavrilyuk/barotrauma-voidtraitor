<?xml version="1.0" encoding="utf-8"?>
<Afflictions>
  <!-- Admin ghost (VoidTraitor Lua/features/adminghost.lua): invisible to everyone except the admin controlling it.
       It is a buff so it keeps working while the ghost is Unkillable. Pressure protection stops the camera shake,
       and its own oxygen (like a diving suit) keeps the ghost from using up a room's air or drowning on the
       admin's client, which doesn't know the ghost is Unkillable. -->
  <Affliction identifier="vt_adminghost" type="vt_adminghost" isbuff="true" limbspecific="false" maxstrength="1"
    showiconthreshold="1000" showinhealthscannerthreshold="1000" healableinmedicalclinic="false">
    <Effect minstrength="0" maxstrength="1" strengthchange="0">
      <StatusEffect target="Character" indetectable="true" PressureProtection="100000" OxygenAvailable="100" UseHullOxygen="false" setvalue="true" />
      <StatusEffect target="Character" invisibletimer="1" setvalue="true">
        <Conditional IsLocalPlayer="false" />
      </StatusEffect>
    </Effect>
    <icon texture="Content/UI/MainIconsAtlas.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>
</Afflictions>
