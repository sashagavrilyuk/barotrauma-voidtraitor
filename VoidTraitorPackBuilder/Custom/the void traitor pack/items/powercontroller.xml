    <BrokenSprite texture="Content/Items/Electricity/PowerDistributor.png" sourcerect="128,0,112,128" depth="0.8" maxcondition="80" fadein="true" />
    <BrokenSprite texture="Content/Items/Electricity/PowerDistributor.png" sourcerect="128,128,112,128" depth="0.8" maxcondition="0" />
