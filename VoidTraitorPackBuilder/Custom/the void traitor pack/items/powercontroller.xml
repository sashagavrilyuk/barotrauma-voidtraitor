    <CustomInterface canbeselected="true" elementstates="True">
      <GuiFrame relativesize="0.2,0.06" minsize="450,50" anchor="Center" relativeoffset="0.0,-0.29" style="ItemUI" />
      <!-- The game hides interface elements that set no property, run no effect and have no wire, so the switch names
           a property no component has: the game shows it and sets nothing. The starting signal keeps the game from
           reading a missing one. -->
      <TickBox text="PowerControllerPower" propertyname="vt_powerswitch" signal="True" />
    </CustomInterface>
    <!-- status strip, switched by the server: green while on, red while off -->
