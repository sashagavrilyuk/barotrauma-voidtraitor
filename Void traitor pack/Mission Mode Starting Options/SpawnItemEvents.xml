    <!--This one is a bit more complicated due to needing to remove existing suits to allow other suits to spawn-->
    <ScriptedEvent identifier="LCAutofilldivingsuit">
      <TagAction criteria="itemidentifier:divingsuit" tag="divingsuit" Submarinetype="Player" />
      <TagAction criteria="itemtag:divingsuitcontainer" tag="divingsuitcontainer" Submarinetype="Player" />
      <StatusEffectAction targettag="divingsuit">
        <StatusEffect target="This">
          <Conditonal hastag="divingsuitcontainer" targetcontainer="true" />
          <RemoveItem />
        </StatusEffect>
      </StatusEffectAction>
      <StatusEffectAction targettag="divingsuitcontainer">
        <StatusEffect target="This" disabledeltatime="true" stackable="false" spawnitemrandomly="true">
          <!--Baro probability jank, count="x" value does not work with spawnitemrandomly, can probably be done better, but it's only once per round (in theory not causing any issues of lag) and I know this method works-->
          <SpawnItem identifiers="PUCS" spawnposition="ThisInventory" />
          <!--1/24 chance-->
          <SpawnItem identifiers="slipsuit" spawnposition="ThisInventory" />
          <!--2/24 chance-->
          <SpawnItem identifiers="slipsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="abyssdivingsuit" spawnposition="ThisInventory" />
          <!--4/24 chance-->
          <SpawnItem identifiers="abyssdivingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="abyssdivingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="abyssdivingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="combatdivingsuit" spawnposition="ThisInventory" />
          <!--4/24 chance-->
          <SpawnItem identifiers="combatdivingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="combatdivingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="combatdivingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="divingsuit" spawnposition="ThisInventory" />
          <!--10/24 chance-->
          <SpawnItem identifiers="divingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="divingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="divingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="divingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="divingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="divingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="divingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="divingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="divingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="divingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="divingsuit" spawnposition="ThisInventory" />
          <SpawnItem identifiers="divingsuit" spawnposition="ThisInventory" />
        </StatusEffect>
      </StatusEffectAction>
      <TagAction criteria="itemtag:diving" tag="spawneddivingsuit" Submarinetype="Player" />
      <!--Spawn oxygen inside suits afterwards-->
      <StatusEffectAction targettag="spawneddivingsuit">
        <StatusEffect target="This" disabledeltatime="true" stackable="false">
          <SpawnItem identifiers="oxygentank" spawnposition="ThisInventory" />
        </StatusEffect>
      </StatusEffectAction>
    </ScriptedEvent>
