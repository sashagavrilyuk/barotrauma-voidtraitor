  <!--для кислородного пистолета-->
  <Affliction name="" identifier="artmod_hyperoxia" iconcolors="25,255,25,255;25,155,25,255;25,25,255,255" description="" limbspecific="false" maxstrength="100" activationthreshold="0" showiconthreshold="0" showicontoothersthreshold="0">
    <Description textidentifier="hyperoxia.1" target="OtherCharacter" minstrength="0" maxstrength="25" />
    <Description textidentifier="hyperoxia.2" target="OtherCharacter" minstrength="25" maxstrength="50" />
    <Description textidentifier="hyperoxia.3" target="OtherCharacter" minstrength="50" maxstrength="100" />
    <Description textidentifier="hyperoxia.1.self" target="Self" minstrength="0" maxstrength="25" />
    <Description textidentifier="hyperoxia.2.self" target="Self" minstrength="25" maxstrength="50" />
    <Description textidentifier="hyperoxia.3.self" target="Self" minstrength="50" maxstrength="100" />
    <Effect minstrength="0" maxstrength="25" strengthchange="-0.5" resistancefor="oxygenlow" minresistance="1" maxresistance="1" />
    <Effect minstrength="25" maxstrength="50" strengthchange="-0.5" resistancefor="oxygenlow" minresistance="1" maxresistance="1" />
    <Effect minstrength="50" maxstrength="100" strengthchange="-0.5" resistancefor="oxygenlow" minresistance="1" maxresistance="1" />
    <PeriodicEffect mininterval="1" maxinterval="1">
      <StatusEffect target="Character" disabledeltatime="true">
        <Conditional artmod_hyperoxia="gt 0" />
        <ReduceAffliction identifier="oxygenlow" strength="10" />
      </StatusEffect>
    </PeriodicEffect>
    <PeriodicEffect mininterval="2" maxinterval="15">
      <StatusEffect target="Character" comparison="and" disabledeltatime="true">
        <Conditional artmod_hyperoxia="gt 25" />
        <Conditional artmod_hyperoxia="lt 50" />
        <Affliction identifier="organdamage" strength="10" probability="0.1" />
        <Affliction identifier="Nausea" strength="10" probability="0.5" />
      </StatusEffect>
    </PeriodicEffect>
    <PeriodicEffect mininterval="2" maxinterval="8">
      <StatusEffect target="Character" disabledeltatime="true">
        <Conditional artmod_hyperoxia="gte 50" />
        <Affliction identifier="nausea" strength="10" probability="0.25" />
      </StatusEffect>
    </PeriodicEffect>
    <PeriodicEffect mininterval="2" maxinterval="10">
      <StatusEffect target="Character" comparison="and" disabledeltatime="true">
        <Conditional artmod_hyperoxia="gte 50" />
        <Conditional artmod_hyperoxia="lt 75" />
        <Affliction identifier="organdamage" strength="10" probability="0.1" />
      </StatusEffect>
    </PeriodicEffect>
    <PeriodicEffect mininterval="2" maxinterval="5">
      <StatusEffect target="Character" disabledeltatime="true">
        <Conditional artmod_hyperoxia="gte 75" />
        <Affliction identifier="organdamage" strength="10" probability="0.1" />
      </StatusEffect>
    </PeriodicEffect>
    <icon texture="%ModDir%/More Arts (AOCS)/Afflictions/Fireresist.png" sourcerect="0,0,128,128" color="10,193,114,255" origin="0,0" />
  </Affliction>
