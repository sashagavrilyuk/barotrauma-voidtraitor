    </CustomInterface>
    <ItemContainer capacity="1" maxstacksize="1" hideitems="true" containedstateindicatorstyle="battery" SpawnWithId="safechip">
      <Containable items="mobilebattery">
        <StatusEffect type="OnContaining" targettype="This" Voltage="1.0" setvalue="true" />
      </Containable>
      <SubContainer capacity="1" maxstacksize="1" hideitems="true" >
        <Containable items="safechip" />
      </SubContainer>
    </ItemContainer>
  </Item>


