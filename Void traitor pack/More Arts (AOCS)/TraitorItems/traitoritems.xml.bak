    <Body width="35" height="65" density="20" />
    <MeleeWeapon canBeCombined="true" removeOnCombined="true" slots="Any,RightHand,LeftHand" aimpos="40,5" handle1="-5,0" holdangle="220" reload="1.0" msg="ItemMsgPickUpSelect">
      <StatusEffect type="OnUse" target="This" Condition="-100.0" disabledeltatime="true" />
      <StatusEffect tags="poison" type="OnUse" target="Character" duration="20">
        <Sound file="Content/Items/Medical/Syringe.ogg" range="500" volume="0.25"/>
        <Affliction identifier="deliriuminepoisoning" amount="1" />
		<Affliction identifier="blue_clowned" amount="10.0" />
      </StatusEffect>
      <StatusEffect type="OnBroken" target="This" delay="10" condition="10000"/>
    </MeleeWeapon>
  </Item>
  
  <Item name="" identifier="transformationgiftsyringe_traitor" health="1" category="Hidden" hideinmenus="true" maxstacksize="1" cargocontaineridentifier="chemicalcrate" Tags="smallitem,chem,medical" description="" useinhealthinterface="true" scale="0.15" impactsoundtag="impact_metal_light" RequireAimToUse="True">
    <Upgrade gameversion="0.10.0.0" scale="0.5" />
