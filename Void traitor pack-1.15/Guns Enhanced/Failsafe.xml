      <!-- FAILSAFE EVENTS | triggered at the start of each round to reset guns in case the reloading animation was interrupted by loading screen -->
      <ScriptedEvent identifier="reset.alienpistol">
        <!-- tag the gun so event actions can target it -->
        <TagAction criteria="itemidentifier:alienpistol" tag="alienpistol" />
        <!-- tag the reload proxy item so event actions can target it -->
        <TagAction criteria="itemidentifier:alpreloading" tag="alpreloading" />
        <!-- reset gun values to default -->
        <StatusEffectAction targettag="alienpistol">
          <StatusEffect target="This" aimpos="90,0" handle1="2,-7" holdpos="0,0" holdangle="0" aimangle="0" condition="100" setvalue="true" />
          <StatusEffect targetitemcomponent="LightComponent" target="This" lightcolor="175,175,225,0" setvalue="true" />
          <StatusEffect targetitemcomponent="ItemContainer" target="This" AllowAccess="true" setvalue="true" />
          <StatusEffect target="This" hideitems="false" setvalue="true" />
        </StatusEffectAction>
        <!-- reset proxy item to full condition to allow the gun to shoot again -->
        <StatusEffectAction targettag="alpreloading">
          <StatusEffect target="This" condition="100" setvalue="true" />
        </StatusEffectAction>
      </ScriptedEvent>
